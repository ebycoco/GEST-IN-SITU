+// PATCHED (GEST-IN-SITU, patch-package, dev-only) : voir patches/playwright-core+*.patch
+//
+// Électron 30+ rejette "--remote-debugging-port=0" comme argument CLI brut
+// (crash natif avant même l'exécution de ce fichier — voir
+// https://github.com/microsoft/playwright/issues/39008). Le port n'est donc
+// plus injecté dans les arguments CLI (coreBundle.js) ; il est appliqué ici
+// via app.commandLine.appendSwitch(), avant app.whenReady().
+//
+// ⚠️ Point de synchronisation NON déterministe (constat empirique révisé) :
+// un premier correctif accédait à `import_electron.app` de façon synchrone,
+// immédiatement après `require('electron')`. Un sondage instrumenté sur 18
+// lancements contrôlés (voir .tmp-timing/, session de diagnostic) a montré
+// `app` disponible de façon synchrone dans 100% des cas mesurés ici — mais
+// un crash `TypeError: Cannot read properties of undefined (reading
+// 'commandLine')` a été reproduit de façon indépendante et répétée (2/2)
+// dans un autre environnement, au MÊME point d'accès synchrone, y compris
+// dans la boucle chromiumSwitches déjà présente avant tout correctif. Cause
+// exacte non identifiée (charge machine, cache disque, variabilité du
+// bootstrap natif d'Electron sous chargement via `-r`) — mais le fait
+// qu'elle survienne de façon reproductible ailleurs suffit à disqualifier
+// tout accès synchrone non gardé comme fix fiable.
+//
+// Solution retenue : ne JAMAIS supposer `app` disponible. `ensureAppReady()`
+// vérifie sa présence et, si absent, réessaie au tick suivant
+// (`process.nextTick`) — sans délai fixe deviné, sans coût observable dans
+// le cas (majoritaire, mesuré 18/18) où `app` est déjà là (une seule
+// vérification synchrone avant de continuer), et sans jamais accéder à
+// `app.commandLine`/`app.whenReady` avant confirmation. Un plafond de
+// tentatives fait échouer bruyamment (erreur explicite) plutôt que de
+// bloquer indéfiniment si `app` ne devient jamais disponible.
+var MAX_APP_READY_ATTEMPTS = 2000; // ~plusieurs secondes de marge via nextTick
+function ensureAppReady(attempt) {
+  attempt = attempt || 0;
+  if (import_electron.app && import_electron.app.commandLine) {
+    setupElectronApp();
+    return;
+  }
+  if (attempt >= MAX_APP_READY_ATTEMPTS) {
+    throw new Error(
+      "[playwright-core PATCHED] electron.app n'est jamais devenu disponible après " +
+      MAX_APP_READY_ATTEMPTS + " tentatives (process.nextTick). Abandon explicite " +
+      "plutôt qu'un blocage silencieux."
+    );
+  }
+  process.nextTick(() => ensureAppReady(attempt + 1));
 }
